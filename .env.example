# ================================================================
# SonarQube Local Stack - Environment Configuration
# ================================================================

# Host port where SonarQube will be exposed.
# Default is 9000. If 9000 is occupied on your machine (e.g. by MinIO/other tools),
# you can change this to 9005, 9002, etc.
SONAR_PORT=9000

# PostgreSQL Database Configuration
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar_secure_dev_pass
POSTGRES_DB=sonar

# Java options for SonarQube's internal Elasticsearch
# Disabling memory mapping ensures reliable startup on Docker Desktop / Windows / WSL
SONAR_SEARCH_JAVAADDITIONALOPTS=-Dnode.store.allow_mmap=false

# Optional SonarQube auth token for running scanner container commands
SONAR_TOKEN=
